{
  "name": "dsh-zentao-ledger",
  "version": "0.1.0",
  "description": "ZenTao bug ledger in the DeepSeek Harness sidebar: triage, drafts, evidence, and explicit submission with readback.",
  "type": "module",
  "license": "MIT",
  "author": "lichufeng123",
  "repository": {"type": "git", "url": "git+https://github.com/lichufeng123/dsh-zentao-ledger.git"},
  "homepage": "https://github.com/lichufeng123/dsh-zentao-ledger#readme",
  "bugs": {"url": "https://github.com/lichufeng123/dsh-zentao-ledger/issues"},
  "keywords": ["dsh-plugin", "deepseek-harness", "zentao", "bug-tracking", "qa", "ledger"],
  "engines": {"node": ">=22", "dsh": ">=0.2.2-rc.1"},
  "exports": {".": "./index.js", "./client": "./client.js", "./icon": "./icon.svg", "./package.json": "./package.json"},
  "files": ["index.js", "config.js", "client.js", "client.css", "icon.svg", "cordis.patch.yml", "src/host/api.mjs", "src/host/session.mjs", "src/host/media.mjs", "src/shared/*.js", "README.zh-CN.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "docs/configuration.md"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]}
  },
  "scripts": {
    "check": "node --check index.js && node --check config.js && node --check client.js && node --check src/host/session.mjs && node --check src/host/api.mjs && node --check src/host/media.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-package.mjs"
  },
  "dependencies": {"@deepseek-ai/schemastery": "^3.19.0"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"}
}
